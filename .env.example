PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=essential_notices
DB_USER=notices_app
DB_PASSWORD=change-this-database-password
DB_SSL=false

# Create a 32-byte key, encode as 64 hex characters. Never commit a real key.
PII_ENCRYPTION_KEY=replace-with-64-hex-characters

# Admin phone in E.164 format.
ADMIN_PHONE=+93700000000
# Generate a private Base32 secret with at least 32 characters, then add it
# to Render's environment settings. Never commit a real authenticator secret.
ADMIN_TOTP_SECRET=replace-with-32-or-more-base32-characters
# Google Maps JavaScript API key (restrict by HTTP referrer and Maps JavaScript API)
GOOGLE_MAPS_API_KEY=
