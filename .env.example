PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=essential_notices
DB_USER=notices_app
DB_PASSWORD=change-this-database-password
DB_SSL=false

# Create a 32-byte key, encode as 64 hex characters. Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=replace-with-64-hex-characters
# Create a long random secret. Example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Admin phone in E.164 format, for example +93700000000
ADMIN_PHONE=+93700000000
OTP_TTL_MINUTES=5
# Twilio Programmable SMS credentials. If unset, OTP sending fails closed.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Google Maps JavaScript API key (restrict by HTTP referrer and Maps JavaScript API)
GOOGLE_MAPS_API_KEY=
